# Copy to .env. Never commit credentials. Demo mode needs no external accounts.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
DATA_DIR=.data
DASHBOARD_TEMPLATE_DIR=dashboard-base
# Remote for the separate base-dashboard repository. Leave empty for a local bare remote.
DASHBOARD_REPO_URL=
# Git authentication: SSH agent / deploy key / credential helper, never a token in this URL.
AI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
BEDROCK_REGION=eu-west-1
BEDROCK_MODEL=eu.anthropic.claude-sonnet-5-5
# Optional secret ARNs. Loaded on startup using the platform AWS identity.
SECRETS_REGION=eu-west-1
ADMIN_PASSWORD_SECRET_ARN=
SESSION_SECRET_ARN=
AWS_CONNECTOR_SECRET_ARN=
AI_CONFIG_SECRET_ARN=
# Local: ADC uses gcloud's default file automatically. Docker: mount the ADC file.
GOOGLE_APPLICATION_CREDENTIALS=
ADC_FILE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=gpt-5.4
AWS_MODE=demo
AWS_REGION=eu-west-1
# Prefer workload identity; otherwise use NEW credentials, not previously exposed keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=
# Compatibility mode uses exact allowlists. Inventory opt-in permits all resource metadata/metrics.
AWS_INVENTORY_ENABLED=false
AWS_REGIONS=eu-west-1
# Contents are separately controlled. Keep DynamoDB records restricted.
AWS_ALLOW_LOG_READS=false
AWS_ALLOW_TABLE_READS=false
AWS_INSTANCE_IDS=
AWS_LOG_GROUPS=
AWS_TABLES=
# Required for production: password >=20 characters, secret >=32 characters.
ADMIN_PASSWORD=
SESSION_SECRET=
RUNTIME_DRIVER=process
MAX_ACTIVE_SESSIONS=4
MAX_SESSIONS=100
MAX_DAILY_PROMPTS=100
SESSION_IDLE_MINUTES=30
SESSION_START_TIMEOUT_MS=120000
# Docker runtime settings (see compose.yaml).
SESSION_IMAGE=von-neumann-session:local
SESSION_DOCKER_NETWORK=von-neumann-sessions
SESSION_HOST_ROOT=
SESSION_VOLUME=von-neumann-data
